---
// The daily map. No 3D engine in the server-rendered graph: the island loads it when a
// spot first opens.
import DailyApp from '../components/react/daily/DailyApp.tsx';
import '../styles/daily.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#111013" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Urban Eclipse</title>
    <link rel="stylesheet" href="/cesium/Widgets/widgets.css" />
  </head>
  <body>
    <DailyApp client:only="react" />
  </body>
</html>
