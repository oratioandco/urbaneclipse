---
// The planner: a model of Berlin in Three.js. It runs entirely in the browser; the page is
// a static shell and the script below builds the scene. The earlier daily map is at /map,
// the first planner at /classic.
import '../miniature/miniature.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#111013" />
    <title>Urban Eclipse</title>
    <script is:inline>
      // Links from the daily map used the hash (#/day=…); send them to where it lives now.
      if (location.hash.startsWith('#/')) location.replace('/map/' + location.hash);
    </script>
  </head>
  <body>
    <canvas id="labels"></canvas>
    <div class="tools">
      <button id="compass" class="round surface" aria-label="Compass: turn to face north"><svg viewBox="-12 -12 24 24" width="26" height="26"><path d="M0,-10 L4,0 L-4,0 Z" fill="#d6453a"/><path d="M0,10 L4,0 L-4,0 Z" fill="currentColor" opacity="0.55"/></svg></button>
      <button id="face-tower" class="round surface eye-only" aria-label="Turn to the TV tower" title="TV tower"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><rect x="11.2" y="1.5" width="1.6" height="7"/><circle cx="12" cy="11" r="3.6"/><path d="M10.6 14.2h2.8l.9 8.3h-4.6z"/></svg></button>
      <button id="face-sun" class="round surface eye-only" aria-label="Turn to the sun" title="Sun" hidden><svg viewBox="0 0 24 24" width="22" height="22"><circle cx="12" cy="12" r="6" fill="#f26a12"/></svg></button>
      <button id="face-moon" class="round surface eye-only" aria-label="Turn to the moon" title="Moon" hidden><svg viewBox="0 0 24 24" width="22" height="22"><path d="M15.5 4.2a8 8 0 1 0 4.3 12.6A7 7 0 0 1 15.5 4.2z" fill="#5b82ff"/></svg></button>
      <button id="help" class="round surface" aria-label="How this works" title="How this works">?</button>
      <button id="layers" class="round surface" aria-label="What the map shows" aria-expanded="false" aria-controls="layers-menu" title="Layers"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M12 3.5 21 8.5 12 13.5 3 8.5z"/><path d="M3 12.5l9 5 9-5"/><path d="M3 16.5l9 5 9-5" opacity="0.5"/></svg></button>
      <button id="tilt" class="round surface overview-only" aria-label="Switch between flat and angled view">2D</button>
      <button id="photographer" class="round surface overview-only" aria-label="Drag onto the map to stand there, or tap to stand in the middle">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><circle cx="12" cy="5" r="3"/><path d="M8 10h8l1 6h-3v6h-4v-6H7z"/><rect x="13.5" y="9" width="6" height="4.2" rx="1"/></svg>
      </button>
    </div>
    <div id="layers-menu" class="layers surface" hidden>
      <div class="layers-head">Map layers</div>
      <label class="layer-row">
        <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M3 20.5 21 13" stroke="#f26a12" stroke-width="2" stroke-linecap="round"/><rect x="11.3" y="2" width="1.4" height="5" fill="currentColor"/><circle cx="12" cy="9" r="2.6" fill="currentColor"/><path d="M11 11.4h2l.6 6.6h-3.2z" fill="currentColor"/></svg></span>
        <span class="text"><b>Tower alignments</b><small>The sun or moon behind the TV tower</small></span>
        <input type="checkbox" class="switch" data-layer="tower" />
      </label>
      <label class="layer-row">
        <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M7 21 10.5 3M17 21 13.5 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity="0.55"/><path d="M12 21V4" stroke="#f2b33d" stroke-width="4" stroke-linecap="round" opacity="0.85"/></svg></span>
        <span class="text"><b>Street henges</b><small>Streets lined up with the sun or moon</small></span>
        <input type="checkbox" class="switch" data-layer="streets" />
      </label>
      <label class="layer-row">
        <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path d="M7.5 18.5h9.3a3.7 3.7 0 0 0 .4-7.4 5 5 0 0 0-9.6-1A4.2 4.2 0 0 0 7.5 18.5z" fill="currentColor" opacity="0.8"/></svg></span>
        <span class="text"><b>Weather</b><small>Forecast clouds in the light and sky</small></span>
        <input type="checkbox" class="switch" data-layer="weather" />
      </label>
      <label class="layer-row">
        <span class="tile" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><text x="12" y="16.5" text-anchor="middle" font-family="ui-sans-serif, system-ui" font-weight="700" font-size="12" fill="currentColor">Aa</text></svg></span>
        <span class="text"><b>Street names</b></span>
        <input type="checkbox" class="switch" data-layer="names" />
      </label>
      <div class="layer-bodies" role="group" aria-label="Sun and moon">
        <label class="body-pill"><input type="checkbox" data-layer="sun" /><svg viewBox="-1 -1 2 2" width="14" height="14" aria-hidden="true"><circle r="0.92" fill="#f8a03a"/><circle r="0.6" fill="#ffd27a"/></svg>Sun</label>
        <label class="body-pill"><input type="checkbox" data-layer="moon" /><svg id="layers-moon" viewBox="-1 -1 2 2" width="14" height="14" aria-hidden="true"><circle r="0.92" fill="#2a3150"/></svg>Moon</label>
      </div>
      <details class="legend">
        <summary>What the marks mean</summary>
        <div><svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true"><path d="M2 6h36" stroke="#f26a12" stroke-width="2.5" stroke-linecap="round"  fill="none"/><circle cx="30" cy="6" r="4" fill="#fff" stroke="#f26a12" stroke-width="2.2"/></svg><span>The line for the chosen time: stand anywhere on it and the sun is behind part of the tower. The ring is where it is behind the sphere.</span></div>
        <div><svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true"><path d="M2 6h36" stroke="#f26a12" stroke-width="1.2" stroke-linecap="round" opacity="0.5" fill="none"/><rect x="24" y="1" width="14" height="10" rx="5" fill="#fff" stroke="#f26a12"/></svg><span>The same line at each hour, with its time at the end or the edge of the view.</span></div>
        <div><svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true"><path d="M2 6h36" stroke="#5b82ff" stroke-width="4" stroke-linecap="round"  fill="none"/></svg><span>The moon behind the antenna: it still shows round the thin mast.</span></div>
        <div><svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true"><path d="M2 6h36" stroke="#f26a12" stroke-width="2" stroke-linecap="round" stroke-dasharray="4 4" fill="none"/></svg><span>The day’s path of sphere spots; dashed where a building is in the way.</span></div>
        <div><svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true"><path d="M2 6h36" stroke="#f2b33d" stroke-width="7" stroke-linecap="round" opacity="0.6" fill="none"/></svg><span>A street henge: sunlight or moonlight runs down the street now.</span></div>
      </details>
      <a id="flatmap" class="flatmap" href="/map/">Flat map, the earlier version &rsaquo;</a>
    </div>
    <dialog id="intro" class="intro surface" aria-labelledby="intro-title">
      <h2 id="intro-title">Line up the sun and moon with Berlin</h2>
      <p class="muted">Find where to stand so the sun or moon sits behind the TV tower, or shines straight down a street.</p>
      <ol>
        <li><b>Pick a day and a time.</b> <span>The coloured bars above the slider show when something lines up. Open the panel for the day’s list.</span></li>
        <li><b>Read the map.</b> <span><em class="sun">Tower alignments</em>: stand on a line and the sun or moon is behind the tower at that hour. <em class="street">Street henges</em>: glowing streets line up with the sun or moon, like Manhattanhenge.</span></li>
        <li><b>See the shot.</b> <span>Drag the photographer onto the map, or hover a line and choose “View from here”. Walk, change lenses, or take off as a drone.</span></li>
      </ol>
      <div class="intro-actions">
        <button id="intro-start" class="chip" type="button">Start</button>
        <span class="muted">Open this again with <b>?</b></span>
      </div>
    </dialog>
    <div class="topleft">
      <button id="back" class="chip surface">&larr; Map</button>
      <button id="takeoff" class="chip surface">&uarr; Take off</button>
    </div>
    <div class="heightbar surface">
      <small>120</small>
      <input id="height" type="range" min="0" max="120" step="1" aria-label="Height above the ground, metres" />
      <small>0</small>
      <span id="height-label" hidden></span>
    </div>
    <canvas id="ghost" hidden></canvas>
    <button id="viewhere" class="chip surface" hidden></button>
    <div id="stats"></div>
    <div class="bottom">
      <canvas id="minimap" aria-label="Map of where you stand. Tap to go back to the map." role="button"></canvas>
      <div class="panel surface">
        <button id="sheet-toggle" type="button" aria-expanded="false" aria-controls="daylist"><i></i><span>Today</span><b aria-hidden="true">&#8963;</b></button>
        <div class="camera-rows">
          <div class="row">
            <span id="facing"></span>
            <span class="keys" aria-label="Walk with W, A, S and D, turn with the arrow keys, rise with E and sink with Q, hold Shift to go faster">
              <kbd data-key="fwd">W</kbd><kbd data-key="left">A</kbd><kbd data-key="back">S</kbd><kbd data-key="right">D</kbd>&nbsp;walk<span class="gap"></span>
              <kbd data-key="turnL">&larr;</kbd><kbd data-key="turnR">&rarr;</kbd>&nbsp;turn<span class="gap"></span>
              <span class="drone-only"><kbd data-key="up">E</kbd><kbd data-key="down">Q</kbd>&nbsp;up/down<span class="gap"></span></span>
              <kbd data-key="run">&#8679;</kbd>&nbsp;faster
            </span>
          </div>
          <div class="status-row">
            <button id="eclipse" type="button" hidden></button>
            <a id="airspace" class="status-pill" href="https://maptool-dipul.dfs.de/" target="_blank" rel="noopener" hidden><span></span>&nbsp;&nearr;</a>
            <button id="dates-toggle" type="button" aria-expanded="false" aria-controls="dates" title="More dates from where you stand"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="14" rx="2" /><path d="M4 10.5h16M8.5 3.5v4M15.5 3.5v4" /></svg><span id="dates-day"></span><b>&middot; Dates</b></button>
          </div>
          <div id="dates" aria-label="More dates from where you stand"></div>
          <div class="lens"><select id="format" aria-label="Camera format"></select><input id="lens" type="range" min="0" max="1000" aria-label="Focal length" /><span id="lens-label"></span><div id="lens-chips" role="group" aria-label="Lens" hidden></div><button id="thirds" type="button" aria-pressed="false" aria-label="Lines at thirds" title="Lines at thirds"><svg viewBox="0 0 16 12" aria-hidden="true"><rect x="0.75" y="0.75" width="14.5" height="10.5" rx="1.5" /><path d="M5.6 1v10M10.4 1v10M1 4.3h14M1 7.7h14" /></svg></button></div>
        </div>
        <div class="row" id="moment-row">
          <input class="clock" id="clock" type="text" inputmode="text" autocomplete="off" spellcheck="false" aria-label="Time: type one, such as 17:50 or 5:50 pm" />
          <div class="daynav">
            <button id="prev-day" type="button" aria-label="Previous day">&lsaquo;</button>
            <label class="daypick">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="6" width="16" height="14" rx="2" /><path d="M4 10.5h16M8.5 3.5v4M15.5 3.5v4" /></svg>
              <span id="day-label"></span>
              <input id="date" type="date" aria-label="Choose a date" />
            </label>
            <button id="today" type="button" hidden>Today</button>
            <button id="next-day" type="button" aria-label="Next day">&rsaquo;</button>
          </div>
          <span class="muted" id="sun"></span>
        </div>
        <div id="weather" class="weather-line" aria-live="polite"></div>
        <div id="tracks" aria-hidden="true"></div>
        <div class="row" id="time-row"><input id="time" type="range" min="0" max="1439" step="1" aria-label="Time of day" /></div>
        <div id="moments" aria-label="Streets lined up today"></div>
        <div id="dayfilter" role="group" aria-label="Show">
          <button type="button" data-layer="sun"><i style="background: var(--sun)"></i>Sun</button>
          <button type="button" data-layer="moon"><i style="background: var(--moon)"></i>Moon</button>
          <span class="sep"></span>
          <button type="button" data-layer="tower">Tower</button>
          <button type="button" data-layer="streets">Streets</button>
        </div>
        <div id="daylist" aria-label="Every chance today"></div>
        <div class="muted" id="moments-empty" hidden>No street lines up with the sun or moon today.</div>
        <div class="muted credit">Map data &copy; OpenStreetMap contributors &middot; Weather: <a href="https://open-meteo.com/" target="_blank" rel="noopener">Open-Meteo</a><span class="eye-credit"> &middot; Lunar surface: NASA&rsquo;s Scientific Visualization Studio</span></div>
      </div>
      <div id="stick" class="walkpad surface" role="application" aria-label="Walk: drag the knob"><div class="knob"></div></div>
    </div>
    <script>
      import '../miniature/main.js';
    </script>
  </body>
</html>
