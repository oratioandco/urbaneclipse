---
// The landing page: what the planner is for, the shots it finds, and how to use it. The
// planner itself is at /plan/. Clips and stills in public/media come from the planner
// (scripts/miniature/record_clips.mjs), not from photographs.
const SHOTS = [
  {
    id: 'sun-sphere',
    body: 'sun',
    title: 'The sun behind the sphere',
    text: 'From the right spot the TV tower’s sphere covers the sun for a minute or two, and a ring of light flares round it. Further out the sun grows past the sphere’s edge.',
    when: 'Thu, 10 Jun 2027 · 9:04 pm',
    where: 'Treptow, across the Spree, 5.3 km SE of the tower, 400 mm',
    href: '/plan/?date=2027-06-10&time=1264&at=52.492250,13.471850&look=307,2.6&lens=400&cam=ff',
  },
  {
    id: 'moon-antenna',
    body: 'moon',
    title: 'The moon on the antenna',
    text: 'A full moon rising or setting behind the thin mast, or a big moon behind the sphere from 4.4 km out. Never hidden behind the sphere, where it simply disappears.',
    when: 'Thu, 18 Feb 2027 · 5:42 am',
    where: 'Treptow, across the Spree, 400 mm',
    href: '/plan/?date=2027-02-18&time=342.083&at=52.492250,13.471850&look=307,3.2&lens=400&cam=ff',
  },
  {
    id: 'street-henge',
    body: 'sun',
    title: 'Street henges',
    text: 'Berlin’s own Manhattanhenge: a few evenings a year the sun sets exactly at the end of a long, straight street. Down Karl-Marx-Allee it goes behind the TV tower.',
    when: 'Mon, 12 Apr 2027 · 7:31 pm',
    where: 'Karl-Marx-Allee at Frankfurter Tor, 200 mm',
    href: '/plan/?date=2027-04-12&time=1171.25&at=52.515750,13.453950&look=280.1,3&lens=200&cam=ff',
  },
];

const STEPS = [
  { img: 'step-day', title: 'Pick a day', text: 'Bars above the time slider show when something lines up. Open the panel for the whole day: tower alignments and street henges, each with Go.' },
  { img: 'step-map', title: 'Read the map', text: 'A line runs through the tower for every hour: stand anywhere on it and the sun or moon is behind the tower then. Glowing streets are lined up right now. Hover a line for “View from here”.' },
  { img: 'step-eye', title: 'Stand there', text: 'See the shot through your own camera’s frame, slide the time to the second, and get a year of dates for the spot you are on.' },
];

const FEATURES = [
  ['Your camera’s frame', 'Full-frame, APS-C, MFT, medium format, phone or drone, with the lens you would use. What is in the frame is what you get.'],
  ['To the second', 'The sun crosses the sphere in a minute or two. Fine timing slides through half an hour in 5-second steps.'],
  ['A year of dates', 'From any spot: every pass behind the tower and down your street for twelve months, checked against the buildings.'],
  ['Clouds included', 'The 16-day forecast drifts over the city, holds back the light and says whether a sunset will catch colour.'],
  ['Go there', 'Directions on foot, the moment in your calendar with an alarm, a link that opens this exact view, and “Where am I?” on site.'],
  ['Drone view', 'Rise to 120 m with the drone’s own lenses, with a warning over the government quarter’s no-fly zone.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#111013" />
    <title>Urban Eclipse: line up the sun and moon with Berlin</title>
    <meta name="description" content="A planner for photographers: where to stand in Berlin so the sun or moon sits behind the TV tower or shines straight down a street, to the minute, with real buildings, light and clouds." />
    <meta property="og:title" content="Urban Eclipse" />
    <meta property="og:description" content="Line up the sun and moon with Berlin’s TV tower and streets." />
    <meta property="og:image" content="/media/berlin-day.jpg" />
    <script is:inline>
      // Shared links from before the planner moved here open the planner, as they always did.
      if (/[?&](date|time|at)=/.test(location.search)) location.replace('/plan/' + location.search + location.hash);
      else if (location.hash.startsWith('#/')) location.replace('/map/' + location.hash);
    </script>
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="11.2" y="1.5" width="1.6" height="7" /><circle cx="12" cy="11" r="3.6" /><path d="M10.6 14.2h2.8l.9 8.3h-4.6z" /></svg>Urban Eclipse</a>
      <a class="button small" href="/plan/">Open the planner</a>
    </header>

    <section class="hero">
      <video class="hero-video" src="/media/berlin-day.mp4" poster="/media/berlin-day.jpg" autoplay muted loop playsinline aria-hidden="true"></video>
      <div class="hero-text">
        <p class="eyebrow">For photographers in Berlin</p>
        <h1>Line up the sun and moon with&nbsp;Berlin</h1>
        <p class="lead">Find where to stand so the sun or moon sits behind the TV tower, or shines straight down a street. To the minute, with the city’s real buildings, light and clouds.</p>
        <div class="actions">
          <a class="button" href="/plan/">Open the planner</a>
          <a class="button ghost" href="#shots">See the shots</a>
        </div>
      </div>
    </section>

    <main>
      <section id="shots" class="section">
        <h2>Three shots the planner finds</h2>
        <p class="intro">Each clip is the planner’s viewfinder on a real date: what the photo would show. Open it and you stand on the spot, with the time and lens set.</p>
        <div class="shots">
          {SHOTS.map((shot) => (
            <article class="shot">
              <a class="shot-media" href={shot.href} aria-label={`Open this shot: ${shot.title}`}>
                <video data-src={`/media/${shot.id}.mp4`} poster={`/media/${shot.id}.jpg`} muted loop playsinline preload="none" />
              </a>
              <div class="shot-body">
                <h3><i class:list={['dot', shot.body]} />{shot.title}</h3>
                <p>{shot.text}</p>
                <p class="example"><b>{shot.when}</b><br />{shot.where}</p>
                <a class="more" href={shot.href}>Open this shot ›</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section">
        <h2>How it works</h2>
        <ol class="steps">
          {STEPS.map((step, i) => (
            <li class="step">
              <img src={`/media/${step.img}.jpg`} alt="" loading="lazy" width="1280" height="800" />
              <div>
                <span class="num">{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="section">
        <h2>Made for the field</h2>
        <div class="features">
          {FEATURES.map(([title, text]) => (
            <div class="feature">
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="section honest">
        <h2>What it knows, and what it doesn’t</h2>
        <ul>
          <li><b>Buildings and ground</b> come from Berlin’s 3D city model (LoD2) and terrain (DGM1), 9 km round the tower. Every view the planner offers is checked against them.</li>
          <li><b>Trees are not in the model.</b> In summer a clear sightline on screen can be leaves on site, so check a park spot before you rely on it.</li>
          <li><b>The sun and moon</b> are computed for the exact time and place; the tower is modelled from its drawings, antenna included.</li>
          <li><b>Clouds</b> come from the Open-Meteo forecast, which reaches 16 days ahead. Beyond that the sky is clear.</li>
        </ul>
      </section>

      <section class="cta">
        <h2>Find your shot</h2>
        <a class="button" href="/plan/">Open the planner</a>
      </section>
    </main>

    <footer class="footer">
      <p>Buildings and terrain: Geoportal Berlin · Map data © OpenStreetMap contributors · Weather: <a href="https://open-meteo.com/">Open-Meteo</a> · Lunar surface: NASA’s Scientific Visualization Studio</p>
      <p><a href="/map/">The earlier flat map</a></p>
    </footer>

    <script>
      // Clips play while they are on screen, and only load once they come near it.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target as HTMLVideoElement;
            if (entry.isIntersecting) {
              if (!video.getAttribute('src')) video.src = video.dataset.src ?? '';
              video.play().catch(() => {});
            } else video.pause();
          }
        },
        { threshold: 0.35 },
      );
      for (const video of document.querySelectorAll('video[data-src]')) observer.observe(video);
      // Respect a wish for less motion: keep the hero still on its poster.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) (document.querySelector('.hero-video') as HTMLVideoElement).pause();
    </script>

    <style is:global>
      :root {
        --bg: #f6f3ee;
        --surface: #fffdf9;
        --ink: #24221f;
        --muted: #6f6a62;
        --line: #e2ddd4;
        --accent: #d9772b;
        --sun: #f26a12;
        --moon: #5b82ff;
        --radius: 14px;
        --gutter: max(16px, env(safe-area-inset-left));
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #111013;
          --surface: #1b1a1f;
          --ink: #ece8df;
          --muted: #a7a3b0;
          --line: #2e2c34;
          color-scheme: dark;
        }
      }
      :root[data-theme='dark'] {
        --bg: #111013;
        --surface: #1b1a1f;
        --ink: #ece8df;
        --muted: #a7a3b0;
        --line: #2e2c34;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 400 16px/1.55 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif; -webkit-font-smoothing: antialiased; }
      a { color: inherit; }
      h1, h2, h3 { line-height: 1.15; letter-spacing: -0.015em; margin: 0; }

      .bar { position: fixed; z-index: 10; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; padding: max(12px, env(safe-area-inset-top)) var(--gutter) 12px; color: #fff; background: linear-gradient(rgba(10, 10, 14, 0.55), rgba(10, 10, 14, 0)); }
      .brand { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; text-decoration: none; letter-spacing: -0.01em; }
      .brand svg { width: 20px; height: 20px; fill: currentColor; }

      .button { display: inline-flex; align-items: center; justify-content: center; height: 46px; padding: 0 22px; border-radius: 23px; background: var(--accent); color: #fff; font-weight: 650; text-decoration: none; white-space: nowrap; transition: transform 0.15s, filter 0.15s; }
      .button:hover { filter: brightness(1.06); transform: translateY(-1px); }
      .button.small { height: 36px; padding: 0 16px; font-size: 14px; }
      .button.ghost { background: rgba(255, 255, 255, 0.14); color: #fff; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.45); backdrop-filter: blur(6px); }

      .hero { position: relative; min-height: min(92vh, 820px); display: grid; align-items: end; overflow: hidden; color: #fff; background: #111013; }
      .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10, 10, 14, 0.72) 0%, rgba(10, 10, 14, 0.38) 45%, rgba(10, 10, 14, 0) 75%), linear-gradient(180deg, rgba(10, 10, 14, 0) 40%, rgba(10, 10, 14, 0.7) 100%); }
      @media (max-width: 860px) { .hero::after { background: linear-gradient(180deg, rgba(10, 10, 14, 0.15) 0%, rgba(10, 10, 14, 0.55) 45%, rgba(10, 10, 14, 0.85) 100%); } }
      .hero-text { position: relative; z-index: 1; max-width: 760px; padding: 0 var(--gutter) clamp(40px, 8vh, 88px); margin-left: max(0px, calc((100vw - 1120px) / 2)); }
      .eyebrow { margin: 0 0 10px; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.85; }
      h1 { font-size: clamp(36px, 6.4vw, 68px); font-weight: 750; letter-spacing: -0.03em; text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35); }
      .lead { max-width: 600px; margin: 18px 0 26px; font-size: clamp(17px, 2vw, 20px); opacity: 0.92; }
      .actions { display: flex; flex-wrap: wrap; gap: 10px; }

      main { max-width: 1120px; margin: 0 auto; padding: 0 var(--gutter); }
      .section { padding: clamp(56px, 9vw, 104px) 0 0; }
      .section h2 { font-size: clamp(28px, 4vw, 40px); font-weight: 720; }
      .intro { max-width: 620px; margin: 12px 0 0; color: var(--muted); font-size: 17px; }

      .shots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 32px; }
      .shot { display: grid; grid-template-rows: auto 1fr; overflow: hidden; border-radius: var(--radius); background: var(--surface); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 8px 30px rgba(40, 34, 24, 0.08); }
      .shot-media { display: block; aspect-ratio: 3 / 2; background: #1b1a1f; }
      .shot-media video { width: 100%; height: 100%; object-fit: cover; display: block; }
      .shot-body { display: grid; align-content: start; gap: 10px; padding: 18px 20px 20px; }
      .shot h3 { display: flex; align-items: center; gap: 9px; font-size: 19px; }
      .shot p { margin: 0; color: var(--muted); font-size: 15px; }
      .shot .example { padding: 10px 12px; border-radius: 10px; background: var(--bg); color: var(--ink); font-size: 14px; }
      .dot { flex: none; width: 10px; height: 10px; border-radius: 50%; }
      .dot.sun { background: var(--sun); }
      .dot.moon { background: var(--moon); }
      .more { justify-self: start; color: var(--accent); font-weight: 650; text-decoration: none; }
      .more:hover { text-decoration: underline; }

      .steps { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 28px; }
      .step { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(20px, 4vw, 48px); align-items: center; }
      .step:nth-child(even) img { order: 2; }
      .step img { width: 100%; height: auto; border-radius: var(--radius); box-shadow: 0 8px 30px rgba(40, 34, 24, 0.12); background: #1b1a1f; }
      .num { display: inline-grid; place-items: center; width: 30px; height: 30px; margin-bottom: 12px; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 700; font-size: 15px; }
      .step h3 { font-size: 24px; }
      .step p { margin: 10px 0 0; color: var(--muted); font-size: 16.5px; }

      .features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin-top: 32px; overflow: hidden; border-radius: var(--radius); background: var(--line); border: 1px solid var(--line); }
      .feature { padding: 22px; background: var(--surface); }
      .feature h3 { font-size: 17px; }
      .feature p { margin: 8px 0 0; color: var(--muted); font-size: 15px; }

      .honest ul { max-width: 760px; margin: 22px 0 0; padding: 0; list-style: none; display: grid; gap: 12px; }
      .honest li { padding-left: 18px; border-left: 3px solid var(--line); color: var(--muted); }
      .honest li b { color: var(--ink); }

      .cta { display: grid; justify-items: center; gap: 20px; margin: clamp(56px, 9vw, 104px) 0 0; padding: clamp(40px, 6vw, 64px) 20px; border-radius: var(--radius); background: linear-gradient(rgba(10, 10, 14, 0.15), rgba(10, 10, 14, 0.45)), #16151a url('/media/moon-antenna.jpg') center 42% / cover; color: #fff; text-align: center; }
      .cta h2 { font-size: clamp(28px, 4vw, 40px); text-shadow: 0 2px 16px rgba(0, 0, 0, 0.5); }

      .footer { max-width: 1120px; margin: 0 auto; padding: 40px var(--gutter) max(40px, env(safe-area-inset-bottom)); color: var(--muted); font-size: 13px; }
      .footer p { margin: 6px 0; }

      @media (max-width: 860px) {
        .shots, .features { grid-template-columns: minmax(0, 1fr); }
        .step { grid-template-columns: minmax(0, 1fr); }
        .step:nth-child(even) img { order: 0; }
      }
    </style>
  </body>
</html>
