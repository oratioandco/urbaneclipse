---
// Plaster Void scene shell.
//
// IMPORTANT (Constitution Principle I + ssr-graph-guard.test.ts): this file and
// everything under src/pages/ + src/layouts/ MUST NOT import the cesium module. The
// guard test regex-scans these files for a cesium import; keep it out (even in
// comments, since the scan is a naive text match). Cesium stays inside the
// client:only island (src/components/react/CesiumViewer.tsx), which Astro never
// runs on the server.
//
// The page is a static shell: only markup + the client:only island mount point.
// No Cesium, no React, no WebGL in the server-rendered module graph.
import CesiumViewer from '../components/react/CesiumViewer.tsx';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Urban Eclipse — Plaster Void</title>

    <!--
      Cesium UMD loader + widget styles.
      vite-plugin-esium externalizes the cesium module import to the global
      `window.Cesium` at build time, and copies the prebuilt UMD + Assets/Workers/etc.
      into dist/cesium/. HOWEVER its transformIndexHtml injection does NOT fire on
      Astro 7's statically-generated HTML output, so we load the UMD global here
      ourselves (synchronous, in <head>, before the client:only island hydrates). The
      plugin still serves /cesium/ in dev (middleware) and copies it at build, so this
      one tag works in both. No cesium import lives in this file (ssr-graph-guard).
    -->
    <link rel="stylesheet" href="/cesium/Widgets/widgets.css" />
    <script is:inline src="/cesium/Cesium.js"></script>
  </head>
  <body class="m-0 h-full w-full overflow-hidden bg-neutral-100">
    <div class="fixed inset-0 classic-scene">
      <CesiumViewer client:only="react" />
    </div>
    <!-- This is the earlier view, kept as it was. It says so, and on a narrow screen, where its
         panels lie off the screen, it points to the planner instead of showing them cut off. -->
    <a class="classic-legacy" href="/plan/" data-plan-link>Legacy view <span>Open the planner</span></a>
    <div class="classic-narrow" role="note">
      <div class="classic-card">
        <img src="/brand/mark-64.png" width="40" height="40" alt="" />
        <h1>The classic view is built for large screens</h1>
        <p>On a phone its panels do not fit. The planner shows the same sun, moon and tower, and is made for this size.</p>
        <a class="classic-go" href="/plan/" data-plan-link>Open the planner</a>
      </div>
    </div>
    <script is:inline>
      // The planner opens on the day this view was asked for, when the address names one.
      (function () {
        var asked = new URLSearchParams(location.search).get('date') || '';
        var day = /^\d{4}-\d{2}-\d{2}/.exec(asked);
        if (!day) return;
        document.querySelectorAll('[data-plan-link]').forEach(function (a) { a.href = '/plan/?date=' + day[0]; });
      })();
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    height: 100%;
    width: 100%;
  }
  :global(#cesium-container) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* The planner's paper, ink and pills (src/miniature/miniature.css), by hand: this page loads none of it. */
  .classic-legacy {
    position: fixed;
    z-index: 30;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px 6px 14px;
    border-radius: 999px;
    background: rgba(255, 253, 249, 0.92);
    box-shadow: 0 1px 2px rgba(40, 34, 24, 0.12), 0 6px 20px rgba(40, 34, 24, 0.12);
    color: #6f6a62;
    font: 600 13px/1.2 ui-sans-serif, system-ui, sans-serif;
    text-decoration: none;
  }
  .classic-legacy span {
    padding: 5px 11px;
    border-radius: 999px;
    background: #24221f;
    color: #fffdf9;
  }
  .classic-narrow {
    display: none;
  }
  @media (max-width: 760px) {
    .classic-scene,
    .classic-legacy {
      display: none;
    }
    .classic-narrow {
      position: fixed;
      inset: 0;
      z-index: 40;
      display: grid;
      place-items: center;
      padding: 24px;
      background: #f6f3ee;
      color: #24221f;
      font: 400 16px/1.45 ui-sans-serif, system-ui, sans-serif;
    }
    .classic-card {
      max-width: 340px;
      display: grid;
      gap: 12px;
      justify-items: start;
    }
    .classic-card h1 {
      margin: 0;
      font-size: 22px;
      line-height: 1.2;
      font-weight: 700;
    }
    .classic-card p {
      margin: 0;
      color: #6f6a62;
    }
    .classic-go {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 20px;
      border-radius: 999px;
      background: #24221f;
      color: #fffdf9;
      font-weight: 600;
      text-decoration: none;
    }
  }
  :global(.cesium-viewer-bottom) {
    /* Keep the plaster void uncluttered; credit/toolbar hidden by widget flags too. */
    display: none;
  }
</style>
