---
// The planner: a model of Berlin in Three.js. It runs entirely in the browser; the page is
// a static shell and the script below builds the scene. The landing page is at /, the earlier
// daily map at /map, the first planner at /classic.
import '../miniature/miniature.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#111013" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Urban Eclipse</title>
    <script is:inline>
      // Links from the daily map used the hash (#/day=…); send them to where it lives now.
      if (location.hash.startsWith('#/')) location.replace('/map/' + location.hash);
    </script>
  </head>
  <body data-mode="shoot">
    <canvas id="labels"></canvas>
    <div class="tools">
      <button id="compass" class="round surface" data-control="compass"></button>
      <button id="face-tower" class="round surface eye-only" data-control="face-tower"></button>
      <button id="face-sun" class="round surface eye-only" hidden data-control="face-sun"></button>
      <button id="face-moon" class="round surface eye-only" hidden data-control="face-moon"></button>
      <button id="locate" class="round surface" data-control="locate"></button>
      <button id="help" class="round surface" data-control="help"></button>
      <button id="layers" class="round surface" aria-expanded="false" aria-controls="layers-menu" data-control="layers"></button>
      <button id="tilt" class="round surface overview-only" data-control="tilt-flat">2D</button>
      <button id="photographer" class="round surface overview-only" data-control="photographer"></button>
    </div>
    <div id="layers-menu" class="layers surface" hidden>
      <div class="layers-head">Map layers</div>
      <label class="layer-row">
        <span class="tile" aria-hidden="true" data-icon="tower-line"></span>
        <span class="text"><b>Tower alignments</b><small>The sun or moon behind the TV tower</small></span>
        <input type="checkbox" class="switch" data-layer="tower" />
      </label>
      <label class="layer-row">
        <span class="tile" aria-hidden="true" data-icon="henge"></span>
        <span class="text"><b>Street henges</b><small>Streets lined up with the sun or moon</small></span>
        <input type="checkbox" class="switch" data-layer="streets" />
      </label>
      <label class="layer-row">
        <span class="tile" aria-hidden="true" data-icon="cloud"></span>
        <span class="text"><b>Weather</b><small>Forecast clouds in the light and sky</small></span>
        <input type="checkbox" class="switch" data-layer="weather" />
      </label>
      <label class="layer-row">
        <span class="tile" aria-hidden="true" data-icon="cloud-map"></span>
        <span class="text"><b>Clouds on the map</b><small>The forecast's clouds over the city — switch them off when they hide the map</small></span>
        <input type="checkbox" class="switch" data-layer="clouds" />
      </label>
      <label class="layer-row">
        <span class="tile" aria-hidden="true" data-icon="tree"></span>
        <span class="text"><b>Trees</b><small id="trees-note">From the city's tree register, bare in winter</small></span>
        <input type="checkbox" class="switch" data-layer="trees" />
      </label>
      <label class="layer-row">
        <span class="tile" aria-hidden="true" data-icon="names"></span>
        <span class="text"><b>Street names</b></span>
        <input type="checkbox" class="switch" data-layer="names" />
      </label>
      <div class="layer-bodies" role="group" aria-label="Sun and moon">
        <label class="body-pill"><input type="checkbox" data-layer="sun" /><span id="layers-sun" class="body" aria-hidden="true"></span>Sun</label>
        <label class="body-pill"><input type="checkbox" data-layer="moon" /><span id="layers-moon" class="body" aria-hidden="true"></span>Moon</label>
      </div>
      <details class="legend">
        <summary>What the marks mean</summary>
        <div><svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true"><path d="M2 6h36" stroke="#f26a12" stroke-width="2.5" stroke-linecap="round"  fill="none"/><circle cx="30" cy="6" r="4" fill="#fff" stroke="#f26a12" stroke-width="2.2"/></svg><span>The line for the chosen time: stand anywhere on it and the sun is behind part of the tower. The ring is where it is behind the sphere.</span></div>
        <div><svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true"><path d="M2 6h36" stroke="#f26a12" stroke-width="1.2" stroke-linecap="round" opacity="0.5" fill="none"/><rect x="24" y="1" width="14" height="10" rx="5" fill="#fff" stroke="#f26a12"/></svg><span>The same line at each hour, with its time at the end or the edge of the view.</span></div>
        <div><svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true"><path d="M2 6h36" stroke="#5b82ff" stroke-width="4" stroke-linecap="round"  fill="none"/></svg><span>The moon behind the antenna: it still shows round the thin mast.</span></div>
        <div><svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true"><path d="M2 6h36" stroke="#f26a12" stroke-width="2" stroke-linecap="round" stroke-dasharray="4 4" fill="none"/></svg><span>The day’s path of sphere spots; dashed where a building is in the way.</span></div>
        <div><svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true"><path d="M2 6h36" stroke="#f2b33d" stroke-width="7" stroke-linecap="round" opacity="0.6" fill="none"/></svg><span>A street henge: sunlight or moonlight runs down the street now.</span></div>
      </details>
      <a id="flatmap" class="flatmap" href="/map/">Flat map, the earlier version<i data-icon="chevron-right" data-icon-size="16"></i></a>
    </div>
    <dialog id="intro" class="intro surface" aria-labelledby="intro-title">
      <h2 id="intro-title" tabindex="-1" autofocus>Line up the sun and moon with Berlin</h2>
      <p class="muted">A planner for photographers: where to stand, and when, for the shots below. Each one shows a real moment; tap it to stand right there.</p>
      <canvas id="intro-logo" width="960" height="540" aria-hidden="true"></canvas>
      <div class="intro-shots">
        <a class="intro-shot" href="/plan/?date=2027-06-10&time=1264&at=52.492250,13.471850&look=307,2.6&lens=400&cam=ff">
          <img src="/media/sun-sphere.jpg" alt="" width="1198" height="798" />
          <b><i data-body="sun"></i>The sun behind the TV tower</b>
          <span>A small solar eclipse: the sphere covers the sun, or a ring of light flares round it.</span>
        </a>
        <a class="intro-shot" href="/plan/?date=2027-02-18&time=342.083&at=52.492250,13.471850&look=307,3.2&lens=400&cam=ff">
          <img src="/media/moon-antenna.jpg" alt="" width="1198" height="798" />
          <b><i data-body="moon"></i>The moon by the tower</b>
          <span>On the antenna, or a big moon behind the sphere from 4.4 km out.</span>
        </a>
        <a class="intro-shot" href="/plan/?date=2027-04-12&time=1171.25&at=52.515750,13.453950&look=280.1,3&lens=200&cam=ff">
          <img src="/media/street-henge.jpg" alt="" width="1198" height="798" />
          <b><i data-body="sun"></i>Street henges</b>
          <span>Sunset or moonrise straight down a long street, a few days a year.</span>
        </a>
        <a class="intro-shot" href="/plan/?date=2027-06-10&time=1250&at=52.492250,13.471850&look=307,1.5&lens=70&cam=drone-3&fly=110">
          <img src="/media/drone.jpg" alt="" width="900" height="675" />
          <b><i data-icon="drone" data-icon-size="16"></i>Eye level and drone</b>
          <span>Stand anywhere with your camera and lens, walk, or rise to 120 m.</span>
        </a>
      </div>
      <ol>
        <li><b>Pick a day.</b> <span>The panel shows its light, its weather and its shots on one timeline; drag it to move the sun. Each shot says Go, Maybe or Skip, and why.</span></li>
        <li><b>Read the map.</b> <span><em class="sun">Tower lines</em>: stand on one and the sun or moon is behind the tower at that hour. <em class="street">Glowing streets</em> are lined up now.</span></li>
        <li><b>Stand there.</b> <span>Drag the photographer onto the map, or choose “View from here” on a line. Then see dates, timing and directions.</span></li>
      </ol>
      <div class="intro-actions">
        <button id="intro-start" class="chip" type="button">Start planning</button>
        <span class="muted">Open this again with <b>?</b> &middot; <a href="/">About</a></span>
      </div>
    </dialog>
    <div class="topleft">
      <button id="back" class="chip surface" data-control="back" data-icon-size="18">Map</button>
      <button id="takeoff" class="chip surface" data-control="takeoff" data-icon-size="18">Take off</button>
      <button id="share" class="chip surface" aria-expanded="false" aria-controls="share-menu" data-control="go-there" data-icon-size="18">Go there</button>
    </div>
    <div id="share-menu" class="sharemenu surface" hidden>
      <a id="directions" class="shareitem" target="_blank" rel="noopener" data-icon="pin"><span><b>Directions</b><small id="directions-app"></small></span></a>
      <button id="calendar" type="button" class="shareitem" data-icon="calendar"><span><b>Add to calendar</b><small id="calendar-what"></small></span></button>
      <button id="copylink" type="button" class="shareitem" data-icon="link"><span><b id="copylink-label">Copy link</b><small>Opens this exact view</small></span></button>
    </div>
    <div id="toast" class="toast surface" role="status" aria-live="polite" hidden></div>
    <div id="loading" class="loading surface" role="status" aria-live="polite"><i aria-hidden="true"></i><span>Building Berlin</span></div>
    <div class="heightbar surface">
      <small>120</small>
      <input id="height" type="range" min="0" max="120" step="1" aria-label="Height above the ground, metres" />
      <small>0</small>
      <span id="height-label" hidden></span>
    </div>
    <canvas id="ghost" hidden></canvas>
    <button id="viewhere" class="chip surface" hidden></button>
    <div id="stats"></div>
    <div class="bottom" id="sheet">
      <canvas id="minimap" aria-label="Map of where you stand. Tap to go back to the map." role="button"></canvas>
      <div id="stick" class="walkpad surface" role="application" aria-label="Walk: drag the knob"><div class="knob"></div></div>
      <div class="credit surface">Map &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> &middot; Weather <a href="https://open-meteo.com/" target="_blank" rel="noopener">Open-Meteo</a><span class="eye-credit"> &middot; Moon NASA SVS</span></div>
      <div class="panel surface" id="panel">
        <div class="sheet-head" id="sheet-head">
          <button id="sheet-grab" class="sheet-grab" type="button" aria-label="Panel height: press to step through peek, half and full, or use the up and down arrow keys"><i aria-hidden="true"></i></button>
          <button id="sheet-toggle" class="peek" type="button" aria-expanded="true" aria-controls="sheet-body"><span id="peek-line" class="peek-line"><span class="what">Looking for the next shot&hellip;</span></span></button>
          <button id="sheet-step" class="icon-btn" type="button" aria-label="Show the list of shots" aria-controls="planning" title="List of shots" data-icon="chevron-up"></button>
          <button id="panel-fold" class="icon-btn" type="button" aria-label="Fold the panel to the side" aria-controls="sheet-body" title="Fold the panel" data-icon="chevron-left"></button>
        </div>
        <div class="rail" id="rail" role="toolbar" aria-label="Panel, folded" aria-orientation="vertical">
          <button id="rail-open" class="icon-btn" type="button" aria-label="Open the panel" aria-controls="sheet-body" title="Open the panel" data-icon="chevron-right"></button>
          <button id="rail-next" class="rail-next" type="button"></button>
          <button id="rail-day" class="icon-btn" type="button" aria-label="The day: light, weather and shots" title="The day" data-phase="day"></button>
          <button id="rail-plan" class="icon-btn" type="button" aria-label="The coming days&rsquo; shots" title="Coming days" data-icon="calendar"></button>
        </div>
        <div class="sheet-body" id="sheet-body">
          <div id="ticket-shot" class="ticket-shot" hidden></div>
          <div class="ticket-head">
            <button id="eclipse" type="button" hidden></button>
            <button id="ticket-more" class="pill" type="button" aria-expanded="false" aria-controls="camera-rows">More</button>
            <button id="minimap-toggle" class="icon-btn" type="button" aria-pressed="false" data-control="minimap" data-icon-size="20"></button>
          </div>
          <div class="tabs" role="group" aria-label="Which shots to list">
            <button type="button" data-mode="plan" aria-pressed="true">Next 3 days</button>
            <button type="button" data-mode="shoot" aria-pressed="false">This day</button>
          </div>
          <section class="dayview" id="dayview" aria-label="The day">
            <div class="row" id="moment-row">
              <input class="clock" id="clock" type="text" inputmode="text" autocomplete="off" spellcheck="false" aria-label="Time: type one, such as 17:50 or 5:50 pm" />
              <div class="daynav">
                <button id="prev-day" type="button" data-control="prev-day" data-icon-size="18"></button>
                <label class="daypick" data-icon="calendar" data-icon-size="16">
                  <span id="day-label"></span>
                  <input id="date" type="date" aria-label="Choose a date" />
                </label>
                <button id="today" type="button" hidden>Today</button>
                <button id="next-day" type="button" data-control="next-day" data-icon-size="18"></button>
              </div>
              <span class="muted" id="sun" hidden></span>
            </div>
            <div class="shots">
              <div class="shots-head"><span id="shots-title">Shots</span><span id="shots-count" class="muted" aria-live="polite"></span></div>
              <div class="shots-row" id="shots-row" role="group" aria-labelledby="shots-title"></div>
            </div>
            <div class="timeline" id="timeline">
              <svg id="tl-plot" class="tl-plot" preserveAspectRatio="none" aria-hidden="true"></svg>
              <div id="tl-bar" class="tl-bar" aria-hidden="true"></div>
              <div id="tl-thumb" class="tl-thumb" aria-hidden="true"><span id="tl-label" class="tl-label"></span><i id="tl-moon" class="tl-dot tl-dot-moon"></i><i id="tl-sun" class="tl-dot tl-dot-sun"></i><b class="tl-grip"></b></div>
              <div class="row" id="time-row"><input id="time" type="range" min="0" max="1439" step="any" aria-label="Time of day" /><button id="fine" type="button" aria-pressed="false" title="Fine timing: half an hour either side, to 5 seconds">&plusmn;30 min</button></div>
            </div>
            <div id="dv-readout" class="dv-readout"></div>
            <div class="dv-nav" role="group" aria-label="Step through the day">
              <button id="dv-earlier" type="button" data-control="shot-earlier" data-icon-size="18">Shot</button>
              <button id="dv-minus" type="button" data-control="minute-back" data-icon-size="16">1 min</button>
              <button id="dv-plus" type="button" data-control="minute-forward" data-icon-size="16">1 min</button>
              <button id="dv-later" type="button" data-control="shot-later" data-icon-size="18" data-icon-after>Shot</button>
            </div>
          </section>
          <section class="overview" id="overview" aria-label="The next three days">
            <div id="plan-head">
              <div id="moon-head">
                <span id="moon-head-disc" class="body" aria-hidden="true"></span>
                <span id="moon-head-text"></span>
              </div>
              <div class="plan-filter" role="group" aria-label="Which body">
                <button type="button" data-filter="all" aria-pressed="true">All</button>
                <button type="button" data-filter="sun" aria-pressed="false">Sun</button>
                <button type="button" data-filter="moon" aria-pressed="false">Moon</button>
              </div>
            </div>
            <div id="sparkstrip" role="group" aria-label="The next three days at a glance: light, cloud, and when the shots fall"></div>
          </section>
          <div class="camera-rows" id="camera-rows">
            <canvas id="horizon" role="img" aria-label="Horizon from here"></canvas>
            <div class="row">
              <span id="facing"></span>
              <span class="keys" aria-label="Walk with W, A, S and D, turn with the arrow keys, rise with E and sink with Q, hold Shift to go faster">
                <kbd data-key="fwd">W</kbd><kbd data-key="left">A</kbd><kbd data-key="back">S</kbd><kbd data-key="right">D</kbd>&nbsp;walk<span class="gap"></span>
                <kbd data-key="turnL">&larr;</kbd><kbd data-key="turnR">&rarr;</kbd>&nbsp;turn<span class="gap"></span>
                <span class="drone-only"><kbd data-key="up">E</kbd><kbd data-key="down">Q</kbd>&nbsp;up/down<span class="gap"></span></span>
                <kbd data-key="run">&#8679;</kbd>&nbsp;faster
              </span>
            </div>
            <div class="status-row">
              <a id="airspace" class="status-pill" href="https://maptool-dipul.dfs.de/" target="_blank" rel="noopener" hidden><span></span><i data-icon="external" data-icon-size="14"></i></a>
              <button id="dates-toggle" type="button" aria-expanded="false" aria-controls="dates" data-control="more-dates" data-icon-size="16"><span id="dates-day"></span><b>&middot; Dates</b></button>
            </div>
            <div id="dates" aria-label="More dates from where you stand"></div>
            <div class="lens"><select id="format" aria-label="Camera format"></select><input id="lens" type="range" min="0" max="1000" aria-label="Focal length" /><span id="lens-label"></span><div id="lens-chips" role="group" aria-label="Lens" hidden></div><button id="thirds" type="button" aria-pressed="false" data-control="thirds" data-icon-size="18"></button></div>
          </div>
          <section class="planning" id="planning" aria-label="The shots, as a list">
            <div id="plancards" class="mode-plan" role="region" aria-label="The coming days' shots"></div>
            <div id="weather" class="weather-line mode-shoot" aria-live="polite"></div>
            <div id="dayfilter" class="mode-shoot" role="group" aria-label="Show">
              <button type="button" data-layer="sun">Sun</button>
              <button type="button" data-layer="moon">Moon</button>
              <span class="sep"></span>
              <button type="button" data-layer="tower">Tower</button>
              <button type="button" data-layer="streets">Streets</button>
            </div>
            <div id="daylist" class="mode-shoot" aria-label="Every chance today"></div>
          </section>
        </div>
      </div>
    </div>
    <script>
      import '../miniature/main.js';
    </script>
  </body>
</html>
